# ============================================================================
# HOGOPLUS-FS backend environment — copy to `.env` on the server and fill in.
#   cp env.sample .env  &&  nano .env
# (Same content as .env.template, under a non-gitignored filename so it ships
# with the repo.) Every variable the app reads is listed — audited from
# app/config.py Settings + os.getenv usage. REQUIRED = no default, must be set.
# Easiest + safest: copy exact values from the current Emergent backend/.env.
# ============================================================================

# ---- Core datastores (REQUIRED) -------------------------------------------
# Neon Postgres (Singapore) — async URL. Use the -pooler host. (pg_dump auto-strips -pooler.)
DATABASE_URL=postgresql+asyncpg://<user>:<pass>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
# Upstash Redis — MUST be a WRITE-capable token (boot probe fails loudly otherwise).
# Shared with the Emergent backend so scheduler locks + OTP/rate-limit state are global.
REDIS_URL=rediss://default:<token>@<name>.upstash.io:6379

# ---- Auth (REQUIRED) ------------------------------------------------------
# HMAC secret for access/refresh JWTs. MUST be byte-identical to the Emergent backend's
# value, otherwise tokens issued by one backend are rejected by the other during dual-run.
JWT_SECRET=<same-secret-as-emergent>
ACCESS_TOKEN_HOURS=24            # access token lifetime (hours)
REFRESH_TOKEN_DAYS=30           # refresh token lifetime (days)

# ---- OTP / SMS ------------------------------------------------------------
OTP_MODE=demo                    # demo | smsgatewayhub | msg91 | whatsapp  (match Emergent: currently "demo")
DEMO_OTP_ENABLED=true            # allow the fixed demo OTP for demo/whitelisted accounts
DEMO_OTP=123456                  # the fixed OTP used in demo mode
DEMO_OTP_WHITELIST=              # comma-separated +91 numbers allowed to use DEMO_OTP (blank = none)
ALLOW_NEW_REGISTRATION=false     # false at launch = block OTP to unknown numbers (no SMS spend)
# SMSGatewayHub (only used when OTP_MODE=smsgatewayhub):
SMSGATEWAYHUB_API_KEY=           # SMSGatewayHub API key
SMSGATEWAYHUB_SENDER_ID=         # approved 6-char sender/header id
SMSGATEWAYHUB_DLT_TEMPLATE_ID=   # DLT-registered template id
SMSGATEWAYHUB_ENTITY_ID=         # DLT principal entity id (optional; sent only if set)
OTP_TEMPLATE_TEXT=               # EXACT DLT-approved template text with {#var#} placeholder
# MSG91 (only used when OTP_MODE=msg91):
MSG91_AUTH_KEY=                  # MSG91 auth key
MSG91_OTP_TEMPLATE_ID=           # MSG91 OTP template id

# ---- Media storage: Cloudflare R2 (S3-compatible) -------------------------
FILE_STORAGE_MODE=s3             # s3 (production) | local
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com   # R2 S3 endpoint
S3_ACCESS_KEY_ID=                # R2 access key id
S3_SECRET_ACCESS_KEY=            # R2 secret access key
S3_BUCKET=hogoplus-fs            # R2 bucket name

# ---- AWS Rekognition (face match + ANPR plate detection) ------------------
AWS_ACCESS_KEY_ID=               # AWS IAM key with Rekognition access
AWS_SECRET_ACCESS_KEY=           # AWS IAM secret
AWS_REGION=ap-south-1            # Rekognition region (Mumbai)
# Optional external ANPR provider (Rekognition/LLM are the primary path):
ANPR_API_URL=                    # external ANPR endpoint (optional)
ANPR_API_KEY=                    # external ANPR key (optional)

# ---- LLM (AI category, plate/vision fallback, RAG summaries) --------------
EMERGENT_LLM_KEY=                # Emergent universal LLM key (OpenAI/Anthropic/Gemini)

# ---- AI / embeddings ------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2  # fastembed model id
EMBEDDING_CACHE_DIR=/app/backend/.fastembed_cache   # ONNX model cache (mounted volume)
AI_CACHE_TTL=86400               # seconds to cache AI results

# ---- Scheduling / ops -----------------------------------------------------
ESCALATION_HOURS=48              # incident auto-escalation window (hours)
BACKUP_KEEP_LAST=14              # legacy backup retention count
UPLOAD_DIR=/app/backend/uploads  # local upload dir (only used if FILE_STORAGE_MODE=local)
# DUAL-RUN SAFETY: set true on THIS (Mumbai) host while the Emergent backend is still
# live, so only ONE host runs the scheduled jobs. Flip to false (or remove) + restart
# AFTER DNS cutover so Mumbai takes over sweeps/backups/reports. (The Redis NX lock
# already prevents double-runs; this is an extra, explicit guarantee.)
DISABLE_SCHEDULER=true

# ---- Legacy Celery (NOT used in production — no beat/worker runs) ----------
CELERY_BROKER_URL=redis://127.0.0.1:6379/1     # unused in prod; leave default
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2 # unused in prod; leave default

# ---- Test-only (leave UNSET in production) --------------------------------
# TESTING=                       # set only by the pytest suite; MUST be unset in prod
