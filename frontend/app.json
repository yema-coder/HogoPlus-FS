{
  "expo": {
    "name": "Hogo Plus",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hogoplus",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hogoplus.fs",
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos to report factory incidents",
        "NSLocationWhenInUseUsageDescription": "Confirms your attendance location at the factory",
        "NSBluetoothAlwaysUsageDescription": "Detects factory zone beacons for attendance"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0B4F6C"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.hogoplus.fs",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT",
        "POST_NOTIFICATIONS"
      ]
    },
    "locales": {
      "en": "./locales/en.json",
      "hi": "./locales/hi.json",
      "mr": "./locales/mr.json"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B4F6C"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Record short voice notes for factory forms"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Take photos to report factory incidents",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Confirms your attendance location at the factory"
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "neverForLocation": true
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
