{
  "expo": {
    "name": "HogoPlus-FS",
    "slug": "frontend",
    "version": "1.0.23",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hogoplus",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hogoplus.fs",
      "buildNumber": "1.0.14",
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos to report factory incidents",
        "NSLocationWhenInUseUsageDescription": "Confirms your attendance location at the factory",
        "NSBluetoothAlwaysUsageDescription": "Detects factory zone beacons for attendance",
        "NSMicrophoneUsageDescription": "Record voice notes and complaint video sound"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.hogoplus.fs",
      "versionCode": 10023,
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Record short voice notes for factory forms"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Take photos to report factory incidents",
          "microphonePermission": "Record sound while capturing complaint videos"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Confirms your attendance location at the factory"
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-video",
      "./plugins/withBleScanNoNeverForLocation.js"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}